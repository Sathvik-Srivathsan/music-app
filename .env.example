# Copy this file to `.env` (or set these in your shell / CI / Vercel) and fill
# in your own Supabase project credentials. `.env` is git-ignored; never commit
# real values. The Flutter app consumes these through --dart-define at build
# time; the CLI tools (tools/*.dart) read them directly from the environment.

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Your project's public "anon" key (Project Settings -> API -> anon public key)
SUPABASE_ANON_KEY=<your-anon-public-key>
